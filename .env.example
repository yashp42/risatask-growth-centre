# DATABASE_URL: Server-only PostgreSQL pooler connection string for the `app_service` role.
# Never expose to frontend code or VITE_* variables.
DATABASE_URL=""

# SUPABASE_URL: Supabase project URL (served publicly via GET /api/config).
SUPABASE_URL=""

# SUPABASE_PUBLISHABLE_KEY (or SUPABASE_ANON_KEY): Supabase public client key (`sb_publishable_...` or anon JWT).
# Never place a `service_role` or `sb_secret_*` key here.
SUPABASE_PUBLISHABLE_KEY=""

# DEMO_LOGIN_EMAIL & DEMO_LOGIN_PASSWORD: Server-only demo account credentials for one-click "Enter demo".
# Must never appear in logs, responses, or VITE_* client bundle variables.
DEMO_LOGIN_EMAIL=""
DEMO_LOGIN_PASSWORD=""

# APP_ENV: Environment name (e.g., demo | development | staging | production).
APP_ENV="demo"

# EDITION_ID_DEFAULT: Default festival edition identifier (e.g., ED-2026-DEMO).
EDITION_ID_DEFAULT="ED-2026-DEMO"

# OPENROUTER_API_KEY: Server-only OpenRouter API key for future Stage 4 AI Growth Analyst.
# Must remain exclusively on the server; never call OpenRouter from the browser.
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Verified free-tier OpenRouter model ID (e.g., <provider>/<model>:free).
# Must NOT be `openrouter/auto` or a paid model; free models only, no paid fallback.
OPENROUTER_MODEL=""

# APP_URL: Hosted URL injected by the platform runtime at deployment.
APP_URL=""
